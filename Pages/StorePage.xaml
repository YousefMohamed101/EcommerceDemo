<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EcommerceDemo.Models"
             x:Class="EcommerceDemo.Pages.StorePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Padding="20,16,20,12">

            <Label Grid.Column="0"
                   Text="Store"
                   VerticalOptions="Center"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />

            <ImageButton Grid.Column="1"
                         x:Name="Cart"
                         Source="cart_icon.png"
                         WidthRequest="34" HeightRequest="34"
                         Aspect="AspectFit"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center"
                         SemanticProperties.Description="View cart" />

            <Grid Grid.Column="2" WidthRequest="34" HeightRequest="34" VerticalOptions="Center">
                <Image Source="pf_icon.jpeg"
                       Aspect="AspectFill"
                       WidthRequest="34" HeightRequest="34" />
                <Picker x:Name="ProfileRequest"
                        TitleColor="Transparent"
                        BackgroundColor="Transparent"
                        TextColor="Transparent"
                        Opacity="0.01"
                        WidthRequest="34" HeightRequest="34"
                        SemanticProperties.Description="Profile menu">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>None</x:String>
                            <x:String>Profile</x:String>
                            <x:String>Log Out</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Grid>
        </Grid>

        <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource HairlineBorder}" />

        <!-- Content -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="12" Padding="20,16,20,0">

            <Border Grid.Row="0"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource HairlineBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource CardBackground}"
                    Padding="0">
                <SearchBar x:Name="SearchBox"
                           Placeholder="Search products..."
                           TextChanged="OnSearchBarChanged"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextSecondary}"
                           BackgroundColor="Transparent" />
            </Border>

            <CollectionView Grid.Row="1" x:Name="ItemsCollection">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="14" HorizontalItemSpacing="14" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="24" Spacing="6">
                        <Label Text="No products found" FontAttributes="Bold" FontSize="16"
                               TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
                        <Label Text="Try a different search term" FontSize="13"
                               TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:Product}">
                        <Border Stroke="{StaticResource HairlineBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource CardBackground}"
                                Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding .}" />
                                <PointerGestureRecognizer PointerEntered="OnPointerEnter" PointerExited="OnPointerExited" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="0">
                                <Image Source="{Binding Thumbnail}"
                                       Aspect="AspectFit"
                                       HeightRequest="128"
                                       HorizontalOptions="Fill" />

                                <VerticalStackLayout Padding="10,8,10,10" Spacing="2">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                    <Label Text="{Binding Price, StringFormat='{0:C}'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PriceGreen}"
                                           Margin="0,4,0,0" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>